{
  "name": "trading-new-listings",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start": "cross-env CHAIN=mainnet  NODE_ENV=development ts-node ./src/app.ts",
    "build": "tsc",
    "dev": "cross-env CHAIN=mainnet  NODE_ENV=development nodemon",
    "test": "CHAIN=mainnet jest --detectOpenHandles",
    "prod": "cross-env CHAIN=mainnet  NODE_ENV=production yarn build && pm2 start ./dist/app.js --name trading-new-listings",
    "wrapEgld": "CHAIN=mainnet ts-node src/wrapEgld.ts",
    "pm2": "npm run build && CHAIN=mainnet pm2 start ./dist/app.js --name buy-tom",
    "pm2-stop": "pm2 stop buy-tom",
    "pm2-restart": "npm run build && CHAIN=mainnet pm2 restart buy-tom"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.3",
    "@types/node-telegram-bot-api": "^0.64.6",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "@multiversx/sdk-network-providers": "^2.4.3",
    "axios": "^1.6.8",
    "bignumber.js": "^9.1.2",
    "dotenv": "^16.4.5",
    "node-telegram-bot-api": "^0.65.1",
    "winston": "^3.13.0",
    "xsuite": "^0.0.51"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
